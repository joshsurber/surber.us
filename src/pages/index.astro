---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/Base.astro';
import { getPostDate, toUTCString, getPostUrl, getProjectUrl, getExcerpt, imgUrl } from '../utils/content';

const posts = (await getCollection('posts')).sort(
  (a, b) => getPostDate(b).getTime() - getPostDate(a).getTime()
).slice(0, 3);

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.pride || 0) - (b.data.pride || 0)
).slice(0, 3);
---
<BaseLayout bodyClass="home">
    <div id="hero" class="hero | fullbleed even-columns | glow center white" style="--glowcolor: var(--color-black)">
        <p class="brand">Front end developer, focusing on the JAMstack</p>
        <p>
            For over twenty years my career has been food and retail management, with
            web development as a hobby. I am ready to turn web development into a career
            and telling people what to do into a hobby.
            <a href="/contact" class="button">Hire me!</a>
        </p>
    </div>

    <div class="portfolio | card-collection">
        <h2>Portfolio</h2>
        <div class="even-columns">
            {projects.map(project => (
                <div class="card">
                    <header>
                        <h3 class="title">
                            <a href={getProjectUrl(project)}>{project.data.title}</a>
                        </h3>
                    </header>

                    <div class="body | flow">
                        <img src={imgUrl(project.data.image)} alt={project.data.imageAlt} class="border" loading="lazy" decoding="async" />
                        <p>{project.data.overview}</p>
                    </div>

                    <footer><a href={getProjectUrl(project)}>Read more</a></footer>
                </div>
            ))}
        </div>
        <div class="center">
            <a href="/portfolio">Checkout more examples of my work</a>
        </div>
    </div>

    <div class="recent-articles | card-collection">
        <h2>Recent articles</h2>
        <div class="even-columns">
            {posts.map(post => {
                const date = getPostDate(post);
                return (
                    <article class="card">
                        <header>
                            <h3 class="title">
                                <a href={getPostUrl(post)}>{post.data.title}</a>
                            </h3>
                            <time datetime={date.toISOString()}>
                                Posted {toUTCString(date, "D MMM YY")}
                            </time>
                        </header>

                        <div class="body | stacked flow glow" style="--glowcolor: var(--color-white)">
                            <p class={post.data.summary ? "summary" : "excerpt"}>{getExcerpt(post)}</p>
                            {post.data.image && (
                                <img src={imgUrl(post.data.image)} alt={post.data.imageAlt} class="bgimage media" loading="lazy" decoding="async" />
                            )}
                        </div>

                        <footer>
                            <a href={`${getPostUrl(post)}#main`} class="readmore">Read more</a>
                        </footer>
                    </article>
                );
            })}
        </div>
        <div class="center">
            <a href="/blog"> Read more on my blog </a>
        </div>
    </div>
</BaseLayout>
